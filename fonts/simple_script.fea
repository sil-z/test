languagesystem DFLT dflt;
languagesystem latn dflt;

@bc_i = [ i i.l i.ri i.rn i.l.ri i.l.rn ];
@bc_n = [ n n.l n.ri n.rn n.l.ri n.l.rn ];

@ct_l = [ @bc_i @bc_n ];
@ct_ri = [ @bc_i ];
@ct_rn = [ @bc_n ];

lookup i_alts {
    sub @ct_l i' @ct_ri by i.l.ri;
    sub @ct_l i' @ct_rn by i.l.rn;
    sub @ct_l i' by i.l;
    sub i' @ct_ri by i.ri;
    sub i' @ct_rn by i.rn;
} i_alts;

lookup n_alts {
    sub @ct_l n' @ct_ri by n.l.ri;
    sub @ct_l n' @ct_rn by n.l.rn;
    sub @ct_l n' by n.l;
    sub n' @ct_ri by n.ri;
    sub n' @ct_rn by n.rn;
} n_alts;

feature calt {
    lookup i_alts;
    lookup n_alts;
} calt;